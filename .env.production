# ====================================================
# CONFIGURACIÓN DE PRODUCCIÓN - ECOMMERCE MOBILE
# ====================================================
# IMPORTANTE: Este archivo contiene configuración para producción
# Asegúrate de que todas las configuraciones de seguridad estén habilitadas

# ====================================================
# CONFIGURACIÓN DE LA API
# ====================================================
# URL base del backend API - DEBE SER HTTPS
EXPO_PUBLIC_API_BASE_URL=https://tu-dominio.com/api

# ====================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ====================================================
# Entorno de producción
EXPO_PUBLIC_NODE_ENV=production

# ====================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ====================================================
# Nombre de la aplicación
EXPO_PUBLIC_APP_NAME=ECommerce Mobile

# Versión de la aplicación
EXPO_PUBLIC_APP_VERSION=1.0.0

# ====================================================
# CONFIGURACIÓN DE DEBUGGING - DESHABILITADO EN PRODUCCIÓN
# ====================================================
# CRÍTICO: SIEMPRE false en producción
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_API_DEBUG=false

# ====================================================
# CONFIGURACIÓN DE SEGURIDAD - MÁXIMA SEGURIDAD
# ====================================================
# Requerir HTTPS obligatorio
EXPO_PUBLIC_REQUIRE_HTTPS=true

# Certificate Pinning habilitado
EXPO_PUBLIC_CERT_PINNING=true

# Timeout de sesión más corto (30 minutos)
EXPO_PUBLIC_SESSION_TIMEOUT=1800000

# ====================================================
# NOTAS IMPORTANTES PARA PRODUCCIÓN:
# ====================================================
# 1. Verificar que EXPO_PUBLIC_API_BASE_URL use HTTPS
# 2. Confirmar que DEBUG_MODE y API_DEBUG estén en false
# 3. Habilitar Certificate Pinning
# 4. Configurar timeout de sesión apropiado
# 5. Verificar que no haya credenciales hardcodeadas
# 6. Realizar testing de seguridad antes del despliegue
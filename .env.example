# ====================================================
# CONFIGURACIÓN DE LA API
# ====================================================
# URL base del backend API
# Para desarrollo local: http://localhost:3000/api
# Para producción: https://tu-dominio.com/api
# Para red local: http://192.168.1.100:3000/api (reemplaza con tu IP)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ====================================================
# CONFIGURACIÓN DE DESARROLLO
# ====================================================
# Entorno de desarrollo (development, staging, production)
EXPO_PUBLIC_NODE_ENV=development

# ====================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ====================================================
# Nombre de la aplicación
EXPO_PUBLIC_APP_NAME=ECommerce Mobile

# Versión de la aplicación
EXPO_PUBLIC_APP_VERSION=1.0.0

# ====================================================
# CONFIGURACIÓN DE DEBUGGING
# ====================================================
# Habilitar logs de debug (true/false)
EXPO_PUBLIC_DEBUG_MODE=true

# Habilitar logs de API (true/false)
EXPO_PUBLIC_API_DEBUG=true

# ====================================================
# INSTRUCCIONES IMPORTANTES:
# ====================================================
# 1. Copia este archivo como .env
# 2. Reemplaza EXPO_PUBLIC_API_BASE_URL con la URL correcta:
#    - Para desarrollo local: http://localhost:3000/api
#    - Para probar en dispositivo físico: http://TU_IP_LOCAL:3000/api
#    - Para producción: https://tu-dominio.com/api
# 3. En Expo, las variables deben empezar con EXPO_PUBLIC_
# 4. Reinicia el servidor de desarrollo después de cambiar variables
# 5. Este archivo .env debe estar en .gitignore para seguridad